# Selected Model (Google Gemini is recommended & offers a free tier key)
MODEL=gemini/gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Alternatively OpenAI (Paid)
# MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=your_openai_api_key_here

# Gmail Credentials (Required to read/manage real inbox)
# Generate App Password at: myaccount.google.com -> Security -> 2-Step Verification -> App passwords
EMAIL_ADDRESS=your_email@gmail.com
APP_PASSWORD=your_16_character_app_password

# Guardrail Flags (Default Safety Configuration)
DRY_RUN=true
REQUIRE_APPROVAL=true
ENABLE_UNSUBSCRIBE_SUGGESTIONS=false

# Optional Integrations
SLACK_WEBHOOK_URL=
GOOGLE_CALENDAR_CREDENTIALS=
